# local | preview | production
APP_ENV=local
PORT=3001
LOG_LEVEL=info
# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000
# Projet Supabase (JWKS et émetteur des jetons dérivés de cette URL)
SUPABASE_URL=
# Connexion Postgres du rôle nagaw_api (secret, jamais commité). Utiliser le
# pooler Supabase (IPv4), comme en production : l'hôte direct
# db.<ref>.supabase.co n'est joignable qu'en IPv6.
# postgresql://nagaw_api.<ref>:<mot-de-passe>@aws-1-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_URL=
# disable (local) | require | verify-full (+ DATABASE_CA_CERT)
DATABASE_SSL=require
# Notifications push (Web Push, ADR-036) : les trois ensemble, ou aucune.
# Générer la paire une fois : npx web-push generate-vapid-keys
# La clé privée est un secret (Vercel : type Sensitive).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.com
# Secret de la tâche planifiée Vercel Cron (16 caractères au moins).
CRON_SECRET=
