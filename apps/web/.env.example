# URL de l'API NestJS, utilisée côté serveur uniquement (pas de préfixe NEXT_PUBLIC_).
API_URL=http://localhost:3001
# URL publique de ce site, utilisée dans les liens envoyés par e-mail.
SITE_URL=http://localhost:3000
# Projet Supabase : URL et clé *publishable* (publiques par conception).
# Ne jamais mettre ici la clé secrète / service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
